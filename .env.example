# ReviveAI Environment Configuration Template
# Copy this file to backend/.env and populate with your own keys if using live test APIs.

# Razorpay Test Mode Credentials (Optional for simulation; required for Razorpay test mode)
RAZORPAY_KEY_ID=your_razorpay_test_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# AI Model Provider Configuration
# Set NVIDIA_API_KEY to enable NVIDIA NIM inference (e.g. minimaxai/minimax-m3 or meta/llama-3.1-70b-instruct)
# If NVIDIA_API_KEY is unset or empty, ReviveAI automatically falls back to MockProvider for 100% deterministic offline execution.
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=minimaxai/minimax-m3
